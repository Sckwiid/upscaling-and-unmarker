{
  "name": "upscaling-and-unmarker",
  "version": "1.1.0",
  "description": "A GitHub Pages compatible frontend image batch upscaler and unmarker.",
  "license": "MIT",
  "private": true,
  "keywords": [
    "ai",
    "watermark",
    "watermark-remover",
    "image-processing",
    "client-side",
    "privacy",
    "canvas",
    "browser"
  ],
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.0",
    "@techstark/opencv-js": "4.12.0-release.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.376.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "8.0.14",
    "vitest": "^4.1.7"
  },
  "packageManager": "npm@11.6.2"
}
